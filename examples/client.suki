
#include <fundamental.huki>
#include "../include/http.huki"

fn main() -> void {
    char body[4096];
    int status = 0;

    int received = http_post_json(
        "https://httpbin.org/post",
        "{\"nombre\":\"Itsuki\",\"version\":1}",
        body,
        4096,
        &status
    );

    if (received < 0) {
        println("Error al realizar POST");
        return;
    }

    printf("Estado HTTP: %d\n", status);
    printf("Bytes recibidos: %d\n", received);
    printf("Respuesta:\n%s\n", body);
}

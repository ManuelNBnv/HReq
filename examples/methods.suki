#include <fundamental.huki>
#include "../include/http.huki"

fn main() -> void {
    char body[4096];
    int status = 0;
    int received = 0;

    println("=== POST ===");
    received = http_post_json(
        "https://jsonplaceholder.typicode.com/posts",
        "{\"title\":\"Prueba Itsuki\",\"body\":\"Hola API\",\"userId\":1}",
        body, 4096, &status
    );
    printf("Resultado: %d | HTTP: %d\n", received, status);
    if (received >= 0) printf("%s\n", body);

    println("\n=== PUT ===");
    received = http_put_json(
        "https://jsonplaceholder.typicode.com/posts/1",
        "{\"id\":1,\"title\":\"Actualizado\",\"body\":\"Prueba PUT\",\"userId\":1}",
        body, 4096, &status
    );
    printf("Resultado: %d | HTTP: %d\n", received, status);
    if (received >= 0) printf("%s\n", body);

    println("\n=== PATCH ===");
    received = http_patch_json(
        "https://jsonplaceholder.typicode.com/posts/1",
        "{\"title\":\"Actualizado parcialmente\"}",
        body, 4096, &status
    );
    printf("Resultado: %d | HTTP: %d\n", received, status);
    if (received >= 0) printf("%s\n", body);

    println("\n=== DELETE ===");
    received = http_delete(
        "https://jsonplaceholder.typicode.com/posts/1",
        body, 4096, &status
    );
    printf("Resultado: %d | HTTP: %d\n", received, status);
    if (received >= 0) printf("Respuesta: %s\n", body);
}
